local function disableEffect(obj)
    pcall(function()
        if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            obj.Enabled = false
        elseif obj:IsA("Explosion") then
            obj.Visible = false
            obj.BlastRadius = 0
            obj.BlastPressure = 0
        end
    end)
end
