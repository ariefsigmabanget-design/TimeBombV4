local function getRemainingCooldown()
    if isfile and readfile and isfile(COOLDOWN_FILE) then
        local success, content = pcall(readfile, COOLDOWN_FILE)
        if success and content then
            local lastTime = tonumber(content)
            if lastTime then
                local elapsed = os.time() - lastTime
                if elapsed < COOLDOWN_TIME then return COOLDOWN_TIME - elapsed end
            end
        end
    end
    return 0
end

local function setCooldown()
    if writefile then pcall(writefile, COOLDOWN_FILE, tostring(os.time())) end
end

local function formatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    return string.format("%02dh %02dm %02ds", h, m, s)
end

