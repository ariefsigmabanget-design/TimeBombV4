local STRICT_BOUNDARY_WORDS = {"ass", "asses", "hoe", "hoes", "cum"}

local function normalizeText(str)
    return str:lower():gsub("0","o"):gsub("1","i"):gsub("!","i"):gsub("|","i"):gsub("3","e"):gsub("4","a"):gsub("@","a"):gsub("5","s"):gsub("%$","s"):gsub("7","t"):gsub("9","g"):gsub("q","g"):gsub("8","b")
end

local function checkToxic(text)
    local rawLower = text:lower()
    local leetCleaned = normalizeText(text)
    local noSymbols = leetCleaned:gsub("[^a-z]", "")
    local collapsed = noSymbols:gsub("(%a)%1+", "%1")
    
    for _, word in ipairs(BAD_WORDS) do
        if rawLower:find(word) or noSymbols:find(word) or collapsed:find(word) then return true, word end
    end
    for _, word in ipairs(STRICT_BOUNDARY_WORDS) do
        local pattern = "%f[%a]" .. word .. "%f[%z%A]"
        if leetCleaned:find(pattern) or noSymbols == word or collapsed == word then return true, word end
    end
    return false, nil
end

